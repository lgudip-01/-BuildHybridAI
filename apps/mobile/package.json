{
  "name": "@clause-guard/mobile",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:web": "npm run build -w @clause-guard/web",
    "sync": "npm run build:web && cap sync",
    "add:android": "cap add android",
    "add:ios": "cap add ios",
    "open:android": "cap open android",
    "open:ios": "cap open ios",
    "run:android": "npm run sync && cap run android",
    "run:ios": "npm run sync && cap run ios"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/core": "^8.6.0",
    "@capacitor/ios": "^8.6.0",
    "@clause-guard/clause-guard-ai": "*"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "typescript": "^7.0.2"
  }
}
