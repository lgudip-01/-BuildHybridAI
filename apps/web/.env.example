# Copy to .env.local and fill in from Firebase console > Project settings > Your apps > Web app.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Required for hosted/production web builds. Leave empty for localhost development.
# Use the reCAPTCHA Enterprise website key registered for this Firebase web app.
VITE_RECAPTCHA_ENTERPRISE_SITE_KEY=

# Do not add App Check debug tokens or a Gemini Developer API key here.
# VITE_* values are included in the browser bundle.
